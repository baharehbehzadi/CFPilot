@using CashflowPilot.Domain.Entities
@model List<CashflowPilot.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    int page = ViewBag.Page;
    int pageSize = ViewBag.PageSize;
    int total = ViewBag.TotalCount;
    string? selectedAction = ViewBag.SelectedAction;
    string? selectedEntityType = ViewBag.SelectedEntityType;
    string? selectedUserId = ViewBag.SelectedUserId;
    string? dateFrom = ViewBag.DateFrom;
    string? dateTo = ViewBag.DateTo;
    var actions = (IEnumerable<string>)ViewBag.Actions;
    var entityTypes = (IEnumerable<string>)ViewBag.EntityTypes;
    var users = ViewBag.Users;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Audit Log</h5>
    <span class="text-muted small">@total entries total</span>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="AuditLog" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-0">Action</label>
                <select name="auditAction" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var a in actions)
                    {
                        <option value="@a" selected="@(a == selectedAction)">@a</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Entity Type</label>
                <select name="entityType" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var et in entityTypes)
                    {
                        <option value="@et" selected="@(et == selectedEntityType)">@et</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">User</label>
                <select name="userId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id" selected="@(u.Id == selectedUserId)">@u.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">From</label>
                <input type="date" name="dateFrom" value="@dateFrom" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">To</label>
                <input type="date" name="dateTo" value="@dateTo" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a asp-action="AuditLog" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>Changes</th></tr></thead>
                <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-muted small text-nowrap">@log.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                        <td class="small">@log.UserName</td>
                        <td><span class="badge bg-light text-dark">@log.Action</span></td>
                        <td class="text-muted small">@log.EntityType @log.EntityId</td>
                        <td class="small text-muted">@log.Details</td>
                        <td class="small">
                            @if (log.OldValueJson != null)
                            {
                                <div><span class="text-muted">old:</span> <code class="small">@log.OldValueJson</code></div>
                            }
                            @if (log.NewValueJson != null)
                            {
                                <div><span class="text-muted">new:</span> <code class="small">@log.NewValueJson</code></div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No audit entries</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (total > pageSize)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @(page) of @((int)Math.Ceiling((double)total/pageSize))</small>
            <div>
                @if (page > 1) { <a asp-action="AuditLog" asp-route-page="@(page-1)" asp-route-auditAction="@selectedAction" asp-route-entityType="@selectedEntityType" asp-route-userId="@selectedUserId" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo" class="btn btn-sm btn-outline-secondary me-1">← Prev</a> }
                @if (page * pageSize < total) { <a asp-action="AuditLog" asp-route-page="@(page+1)" asp-route-auditAction="@selectedAction" asp-route-entityType="@selectedEntityType" asp-route-userId="@selectedUserId" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo" class="btn btn-sm btn-outline-secondary">Next →</a> }
            </div>
        </div>
    }
</div>
