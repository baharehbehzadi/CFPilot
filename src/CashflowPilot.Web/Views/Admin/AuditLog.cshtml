@using CashflowPilot.Domain.Entities
@model List<CashflowPilot.Domain.Entities.AuditLog>
@{ ViewData["Title"] = "Audit Log"; int page = ViewBag.Page; int pageSize = ViewBag.PageSize; int total = ViewBag.TotalCount; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Audit Log</h5>
    <span class="text-muted small">@total entries total</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
                <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-muted small text-nowrap">@log.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                        <td class="small">@log.UserName</td>
                        <td><span class="badge bg-light text-dark">@log.Action</span></td>
                        <td class="text-muted small">@log.EntityType @log.EntityId</td>
                        <td class="small text-muted">@log.Details</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No audit entries</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (total > pageSize)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @page of @((int)Math.Ceiling((double)total/pageSize))</small>
            <div>
                @if (page > 1) { <a asp-action="AuditLog" asp-route-page="@(page-1)" class="btn btn-sm btn-outline-secondary me-1">← Prev</a> }
                @if (page * pageSize < total) { <a asp-action="AuditLog" asp-route-page="@(page+1)" class="btn btn-sm btn-outline-secondary">Next →</a> }
            </div>
        </div>
    }
</div>
