@model CashflowPilot.Domain.Entities.CommentaryPack
@{
    Layout = null;
    ViewData["Title"] = "Commentary Report";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" /><title>CashflowPilot — Commentary Report</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #222; margin: 2cm; }
        h1 { color: #1a3a5c; font-size: 16pt; border-bottom: 2px solid #1a3a5c; padding-bottom: 8px; }
        h2 { color: #1a3a5c; font-size: 12pt; margin-top: 1.5em; }
        .meta { color: #666; font-size: 9pt; margin-bottom: 1.5em; }
        .section { margin-bottom: 1.5em; }
        .section-title { font-weight: bold; color: #1a3a5c; border-bottom: 1px solid #e0e0e0; padding-bottom: 4px; margin-bottom: 8px; }
        footer { margin-top: 2em; font-size: 8pt; color: #888; border-top: 1px solid #e0e0e0; padding-top: 8px; }
        @@media print { body { margin: 1cm; } }
    </style>
</head>
<body>
<h1>CashflowPilot — Commentary Report</h1>
<div class="meta">
    <strong>Analysis:</strong> @Model.VarianceAnalysis?.ForecastRun?.Name vs @Model.VarianceAnalysis?.ActualRun?.Name<br/>
    <strong>Generated:</strong> @Model.GeneratedAt.ToString("dd MMMM yyyy HH:mm") UTC<br/>
    <strong>Report Date:</strong> @DateTime.UtcNow.ToString("dd MMMM yyyy")
</div>

<div class="section">
    <div class="section-title">Executive Summary</div>
    <p>@Model.ExecutiveSummary</p>
</div>
<div class="section">
    <div class="section-title">Positive Variances</div>
    <p>@Model.PositiveVariances</p>
</div>
<div class="section">
    <div class="section-title">Negative Variances</div>
    <p>@Model.NegativeVariances</p>
</div>
<div class="section">
    <div class="section-title">Delayed Distributions</div>
    <p>@Model.DelayedDistributions</p>
</div>
<div class="section">
    <div class="section-title">Higher-Than-Expected Capital Calls</div>
    <p>@Model.HigherThanExpectedCalls</p>
</div>
<div class="section">
    <div class="section-title">Watchpoints</div>
    <p>@Model.Watchpoints</p>
</div>
<footer>Generated by CashflowPilot &middot; CONFIDENTIAL &middot; For internal use only</footer>
<script>window.onload = function(){ window.print(); }</script>
</body>
</html>
