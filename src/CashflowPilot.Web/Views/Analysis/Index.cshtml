@using CashflowPilot.Domain.Entities
@model List<CashflowPilot.Domain.Entities.VarianceAnalysis>
@{ ViewData["Title"] = "Variance Analyses"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Variance Analyses</h5>
    @if (User.IsInRole("Admin") || User.IsInRole("Analyst"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Analysis</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Name</th><th>Forecast Run</th><th>Actual Run</th><th>Created</th><th>Commentary</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><a asp-action="Detail" asp-route-id="@a.Id" class="fw-semibold text-decoration-none">@a.Name</a></td>
                    <td><span class="text-muted small">@a.ForecastRun?.Name</span></td>
                    <td><span class="text-muted small">@a.ActualRun?.Name</span></td>
                    <td><span class="text-muted small">@a.CreatedAt.ToString("dd MMM yyyy")</span></td>
                    <td>
                        @if (a.CommentaryPack != null)
                        { <span class="badge bg-success-subtle text-success"><i class="bi bi-check"></i> Generated</span> }
                        else
                        { <span class="badge bg-light text-muted">None</span> }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Detail" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary py-0">View</a>
                            <a asp-action="ExportCsv" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary py-0">CSV</a>
                            <a asp-action="ExportExcel" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary py-0">Excel</a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No analyses yet. <a asp-action="Create">Create one</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
