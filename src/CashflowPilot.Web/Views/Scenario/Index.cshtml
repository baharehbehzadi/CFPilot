@model CashflowPilot.Web.Models.ScenarioListViewModel
@{ ViewData["Title"] = "Scenarios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Scenario Analysis</h5>
    @if (User.IsInRole("Admin") || User.IsInRole("Analyst"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Scenario</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th><th>Forecast Run</th>
                    <th class="text-end">Calls Adj</th><th class="text-end">Dist Adj</th>
                    <th class="text-center">Timing Shift (Calls / Dist)</th><th>Scope</th><th>Created</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var sc in Model.Scenarios)
            {
                <tr>
                    <td><a asp-action="Detail" asp-route-id="@sc.Id" class="fw-semibold text-decoration-none">@sc.Name</a></td>
                    <td class="text-muted small">@sc.ForecastRun?.Name</td>
                    <td class="text-end font-monospace small @(sc.CallsAdjustmentPct >= 0 ? "text-danger" : "text-success")">
                        @(sc.CallsAdjustmentPct >= 0 ? "+" : "")@sc.CallsAdjustmentPct.ToString("F1")%
                    </td>
                    <td class="text-end font-monospace small @(sc.DistributionsAdjustmentPct >= 0 ? "text-success" : "text-danger")">
                        @(sc.DistributionsAdjustmentPct >= 0 ? "+" : "")@sc.DistributionsAdjustmentPct.ToString("F1")%
                    </td>
                    <td class="text-center small">
                        @(sc.CallsTimingShiftMonths == 0 ? "None" : $"{(sc.CallsTimingShiftMonths > 0 ? "+" : "")}{sc.CallsTimingShiftMonths}m")
                        /
                        @(sc.DistributionsTimingShiftMonths == 0 ? "None" : $"{(sc.DistributionsTimingShiftMonths > 0 ? "+" : "")}{sc.DistributionsTimingShiftMonths}m")
                    </td>
                    <td class="text-muted small">@Model.ScopeDescriptions.GetValueOrDefault(sc.Id, "All funds")</td>
                    <td class="text-muted small">@sc.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Detail" asp-route-id="@sc.Id" class="btn btn-sm btn-outline-primary py-0">View</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Analyst"))
                            {
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this scenario?')">
                                    <input type="hidden" name="id" value="@sc.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Scenarios.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No scenarios yet. <a asp-action="Create">Create one</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
