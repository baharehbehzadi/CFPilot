@model CashflowPilot.Web.Models.ScenarioDetailViewModel
@{
    ViewData["Title"] = Model.Scenario.Name;
    var r = Model.Result;
    bool deltaPos = r.NetCashflowDelta >= 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">@Model.Scenario.Name</h5>
        <small class="text-muted">Baseline: @Model.Scenario.ForecastRun?.Name</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← All Scenarios</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
        <div class="stat-card">
            <div class="stat-value">@(r.CallsAdjustmentPct >= 0 ? "+" : "")@r.CallsAdjustmentPct.ToString("F1")%</div>
            <div class="stat-label">Calls Adjustment</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="stat-card">
            <div class="stat-value">@(r.DistributionsAdjustmentPct >= 0 ? "+" : "")@r.DistributionsAdjustmentPct.ToString("F1")%</div>
            <div class="stat-label">Distributions Adjustment</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="stat-card">
            <div class="stat-value">@(r.TimingShiftMonths == 0 ? "None" : $"{(r.TimingShiftMonths > 0 ? "+" : "")}{r.TimingShiftMonths}m")</div>
            <div class="stat-label">Timing Shift</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="stat-card">
            <div class="stat-value">@r.BaselineNetCashflow.ToString("N0")</div>
            <div class="stat-label">Baseline Net</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="stat-card">
            <div class="stat-value @(deltaPos ? "variance-pos" : "variance-neg")">
                @(deltaPos ? "+" : "")@r.NetCashflowDelta.ToString("N0")
            </div>
            <div class="stat-label">Net Delta vs Baseline</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Scenario.Description))
{
    <div class="alert alert-light border mb-4">
        <i class="bi bi-info-circle me-1"></i><em>@Model.Scenario.Description</em>
    </div>
}

<div class="card mb-4">
    <div class="card-header">Baseline vs Scenario Net Cashflow</div>
    <div class="card-body"><canvas id="scenarioChart" height="100"></canvas></div>
</div>

<div class="card">
    <div class="card-header">Period Detail</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th class="text-end">Baseline Calls</th><th class="text-end">Scenario Calls</th>
                        <th class="text-end">Baseline Dist</th><th class="text-end">Scenario Dist</th>
                        <th class="text-end">Baseline Net</th><th class="text-end">Scenario Net</th>
                        <th class="text-end">Delta</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in r.Periods)
                {
                    <tr>
                        <td class="fw-semibold small">@p.Period.ToString("MMM-yyyy")</td>
                        <td class="text-end font-monospace small">@p.BaselineCalls.ToString("N0")</td>
                        <td class="text-end font-monospace small">@p.ScenarioCalls.ToString("N0")</td>
                        <td class="text-end font-monospace small">@p.BaselineDistributions.ToString("N0")</td>
                        <td class="text-end font-monospace small">@p.ScenarioDistributions.ToString("N0")</td>
                        <td class="text-end font-monospace small">@p.BaselineNet.ToString("N0")</td>
                        <td class="text-end font-monospace small">@p.ScenarioNet.ToString("N0")</td>
                        <td class="text-end font-monospace small @(p.Delta >= 0 ? "variance-pos" : "variance-neg")">
                            @(p.Delta >= 0 ? "+" : "")@p.Delta.ToString("N0")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    var periods = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Periods.Select(p => p.Period.ToString("MMM-yy")).ToList()));
    var baseline = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Periods.Select(p => (double)p.BaselineNet).ToList()));
    var scenario = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Periods.Select(p => (double)p.ScenarioNet).ToList()));
    new Chart(document.getElementById('scenarioChart'), {
        type: 'bar',
        data: {
            labels: periods,
            datasets: [
                { label: 'Baseline Net', data: baseline, backgroundColor: 'rgba(45,99,153,0.5)', borderColor: '#2d6399', borderWidth: 1 },
                { label: 'Scenario Net', data: scenario, backgroundColor: 'rgba(220,38,38,0.35)', borderColor: '#dc2626', borderWidth: 1 }
            ]
        },
        options: { responsive: true, plugins: { legend: { position: 'top' } } }
    });
})();
</script>
}
