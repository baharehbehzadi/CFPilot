@model CashflowPilot.Domain.Entities.CommentaryPack
@{ ViewData["Title"] = "Commentary"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0">Commentary Pack</h5>
        <small class="text-muted">@Model.VarianceAnalysis?.ForecastRun?.Name vs @Model.VarianceAnalysis?.ActualRun?.Name</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PrintReport" asp-route-analysisId="@Model.VarianceAnalysisId" class="btn btn-outline-secondary btn-sm" target="_blank">
            <i class="bi bi-printer me-1"></i>Print Report
        </a>
        <a asp-controller="Analysis" asp-action="Detail" asp-route-id="@Model.VarianceAnalysisId" class="btn btn-outline-primary btn-sm">← Analysis</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-file-text me-2"></i>Executive Summary</div>
    <div class="card-body"><p class="mb-0">@Model.ExecutiveSummary</p></div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100 border-success">
            <div class="card-header text-success fw-semibold"><i class="bi bi-arrow-up-circle me-2"></i>Positive Variances</div>
            <div class="card-body small">@Model.PositiveVariances</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-danger">
            <div class="card-header text-danger fw-semibold"><i class="bi bi-arrow-down-circle me-2"></i>Negative Variances</div>
            <div class="card-body small">@Model.NegativeVariances</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold text-warning"><i class="bi bi-clock-history me-2"></i>Delayed Distributions</div>
            <div class="card-body small">@Model.DelayedDistributions</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold text-danger"><i class="bi bi-exclamation-circle me-2"></i>Higher-Than-Expected Calls</div>
            <div class="card-body small">@Model.HigherThanExpectedCalls</div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold text-primary"><i class="bi bi-eye me-2"></i>Watchpoints</div>
            <div class="card-body small">@Model.Watchpoints</div>
        </div>
    </div>
</div>
